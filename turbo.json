{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:property": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@jro/rewards-prototype#build": {
      "outputs": []
    }
  }
}
