  },
  "dependencies": {
    "@jro/provisional-rules": "workspace:*",
    "@jro/rule-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.17.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
