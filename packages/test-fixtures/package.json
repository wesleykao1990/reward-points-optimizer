  },
  "dependencies": {
    "@jro/rule-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.17.1",
    "fast-check": "4.2.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
