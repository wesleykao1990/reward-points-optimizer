{
  "name": "@jro/contracts",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:types": "node scripts/generate-types.mjs",
    "validate:schemas": "node --import tsx scripts/validate-schemas.ts",
    "validate:registry": "node --import tsx scripts/validate-registry.ts",
    "validate:examples": "node --import tsx scripts/validate-examples.ts",
    "test": "vitest run",
    "test:property": "vitest run --config vitest.property.config.ts"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "decimal.js": "10.6.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.17.1",
    "fast-check": "4.2.0",
    "json-schema-to-typescript": "15.0.4",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
