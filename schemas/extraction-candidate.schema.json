{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/extraction-candidate.schema.json",
  "title": "LLM-assisted Extraction Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "source_id",
    "source_snapshot_ids",
    "snapshot_hashes",
    "extracted_at",
    "candidate_rules",
    "uncertainties",
    "security_flags",
    "status"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^xc_[a-z0-9_-]+$"
    },
    "source_id": {
      "type": "string"
    },
    "source_snapshot_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^snap_[a-zA-Z0-9_-]+$"
      }
    },
    "snapshot_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidate_rules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_path",
          "question",
          "severity"
        ],
        "properties": {
          "field_path": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "blocking"
            ]
          }
        }
      }
    },
    "security_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "flag_type",
          "locator",
          "action"
        ],
        "properties": {
          "flag_type": {
            "type": "string",
            "enum": [
              "embedded_instruction",
              "script_content",
              "conflicting_text",
              "untrusted_external_link",
              "other"
            ]
          },
          "locator": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "ignored",
              "quarantined",
              "needs_review"
            ]
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "schema_valid",
        "needs_review",
        "rejected"
      ]
    }
  }
}
