{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/trusted-source.schema.json",
  "title": "Trusted Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "publisher",
    "category",
    "tier",
    "publication_use",
    "source_url",
    "authority_scope",
    "locale",
    "geography",
    "evidence_format",
    "volatility",
    "recommended_check_cadence",
    "access",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "publisher": {
      "type": "string",
      "minLength": 2
    },
    "category": {
      "type": "string",
      "enum": [
        "campaign_archive",
        "campaign_directory",
        "campaign_terms",
        "card_product",
        "card_reward_rules",
        "cashback_portal",
        "change_notice",
        "discovery",
        "merchant_campaign_rules",
        "merchant_directory",
        "merchant_program_rules",
        "merchant_rules",
        "payment_reward_rules",
        "program_rules",
        "regulatory",
        "technical",
        "transfer_rules"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "T0_REGULATOR",
        "T1_CANONICAL",
        "T2_OFFICIAL_SUPPORT",
        "T3_PARTNER_CONTRACT",
        "T4_DISCOVERY_ONLY"
      ]
    },
    "publication_use": {
      "type": "string",
      "enum": [
        "canonical",
        "corroborating",
        "discovery_only"
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "authority_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "geography": {
      "type": "string",
      "minLength": 2
    },
    "evidence_format": {
      "type": "string",
      "enum": [
        "html",
        "pdf",
        "api",
        "email",
        "feed",
        "manual_capture"
      ]
    },
    "volatility": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "very_high"
      ]
    },
    "recommended_check_cadence": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "quarterly",
        "before_release",
        "event_driven"
      ]
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrieval_method",
        "requires_login",
        "automation_status",
        "terms_review_status",
        "technical_feasibility"
      ],
      "properties": {
        "retrieval_method": {
          "type": "string",
          "enum": [
            "http_html",
            "official_api",
            "partner_feed",
            "manual_browser",
            "email_ingestion"
          ]
        },
        "requires_login": {
          "type": "boolean"
        },
        "automation_status": {
          "type": "string",
          "enum": [
            "requires_terms_review",
            "official_documentation",
            "official_api",
            "contract_required",
            "manual_only",
            "not_for_production_evidence"
          ]
        },
        "terms_review_status": {
          "type": "string",
          "enum": [
            "not_reviewed",
            "approved",
            "restricted",
            "prohibited",
            "not_applicable"
          ]
        },
        "technical_feasibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_classification",
            "last_observed_at",
            "observation_ids"
          ],
          "properties": {
            "current_classification": {
              "type": "string",
              "enum": [
                "unknown",
                "plain_http_observed_reachable",
                "plain_http_observed_blocked_or_unavailable",
                "environment_dependent_or_mixed",
                "rendering_or_session_likely",
                "manual_capture_candidate",
                "partner_feed_candidate",
                "temporarily_unavailable"
              ]
            },
            "last_observed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "observation_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^sao_[a-z0-9_-]+$"
              }
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url_registered_on",
        "content_verified_on",
        "status",
        "notes"
      ],
      "properties": {
        "url_registered_on": {
          "type": "string",
          "format": "date"
        },
        "content_verified_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "status": {
          "type": "string",
          "enum": [
            "registered",
            "content_verified",
            "temporarily_unavailable",
            "retired",
            "unverified"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
