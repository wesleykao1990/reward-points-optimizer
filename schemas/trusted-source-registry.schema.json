{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/trusted-source-registry.schema.json",
  "title": "Trusted Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "research_cutoff",
    "purpose",
    "important_notice",
    "tier_definitions",
    "sources"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "research_cutoff": {
      "type": "string",
      "format": "date"
    },
    "purpose": {
      "type": "string"
    },
    "important_notice": {
      "type": "string"
    },
    "tier_definitions": {
      "type": "object",
      "required": [
        "T0_REGULATOR",
        "T1_CANONICAL",
        "T2_OFFICIAL_SUPPORT",
        "T3_PARTNER_CONTRACT",
        "T4_DISCOVERY_ONLY"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "trusted-source.schema.json"
      }
    }
  }
}
